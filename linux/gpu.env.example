DATA_ROOT=/srv/village-platform/data
MODELS_ROOT=/srv/village-platform/models
RUNTIME_ROOT=/var/lib/village-platform/runtime
WORKER_ENV_FILE=/etc/village-platform/worker.env
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
