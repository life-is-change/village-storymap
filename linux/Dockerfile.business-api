FROM node:22-bookworm-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562
WORKDIR /app
COPY business-api/package.json business-api/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY business-api/src ./src
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["node"]
CMD ["src/main.mjs"]
