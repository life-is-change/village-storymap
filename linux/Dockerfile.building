FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG APP_UID=10001
ARG APP_GID=10001

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp/village-home \
    XDG_CACHE_HOME=/tmp/village-cache \
    MPLCONFIGDIR=/tmp/village-matplotlib

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY linux/requirements-building.txt /tmp/requirements-building.txt
RUN python3 -m pip install --upgrade \
        pip==25.1.1 \
        setuptools==80.9.0 \
        wheel==0.45.1 \
    && python3 -m pip install \
        torch==2.0.1 \
        torchvision==0.15.2 \
        --index-url https://download.pytorch.org/whl/cu118 \
    && python3 -m pip install --requirement /tmp/requirements-building.txt \
    && python3 -m pip install \
        mmcv-full==1.7.2 \
        --find-links https://download.openmmlab.com/mmcv/dist/cu118/torch2.0/index.html \
    && python3 -m pip check

COPY server/pyproject.toml /app/server/pyproject.toml
COPY server/src /app/server/src
COPY server/config /app/server/config
RUN python3 -m pip install /app/server \
    && rm -f /tmp/requirements-building.txt

RUN groupadd --gid "${APP_GID}" village \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --no-create-home --shell /usr/sbin/nologin village \
    && install -d -o "${APP_UID}" -g "${APP_GID}" /work

WORKDIR /app
USER 10001:10001

CMD ["python3", "-m", "uvicorn", "village_processing.building.service:app", "--host", "0.0.0.0", "--port", "8021"]
